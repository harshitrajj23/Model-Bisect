# Example targets configuration for Model Bisect server

[targets.sklearn_demo_target]
repo_path = "/repos/sklearn_demo"
eval_command = "python train.py"
metric_name = "accuracy"
threshold = 0.95
direction = "higher"
valid_range = [0.0, 1.0]
timeout = 60.0
repeat_count = 1

[targets.digits_target]
repo_path = "/repos/digits_classifier"
eval_command = "python train.py"
metric_name = "accuracy"
threshold = 0.94
direction = "higher"
valid_range = [0.0, 1.0]
timeout = 30.0
repeat_count = 1

[targets.latency_target]
repo_path = "/repos/latency_benchmark"
eval_command = "python benchmark.py"
metric_name = "latency_ms"
threshold = 30.0
direction = "lower"
valid_range = [0.0, 1000.0]
timeout = 30.0
repeat_count = 1

[targets.housing_target]
repo_path = "/repos/housing_regressor"
eval_command = "python train.py"
metric_name = "r2_score"
threshold = 0.40
direction = "higher"
valid_range = [-1.0, 1.0]
timeout = 30.0
repeat_count = 1
